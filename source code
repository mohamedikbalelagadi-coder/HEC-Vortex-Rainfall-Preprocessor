    def _construire_interface(self):
        canvas = tk.Canvas(self.root, highlightthickness=0, bg=self.COULEUR_FOND)
        scrollbar_v = ttk.Scrollbar(self.root, orient="vertical", command=canvas.yview)
        # padding genereux (24) : l'ensemble de l'interface "respire" au lieu
        # de coller aux bords de la fenetre.
        conteneur = ttk.Frame(canvas, padding=(28, 24))

        conteneur.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        id_fenetre_conteneur = canvas.create_window((0, 0), window=conteneur, anchor="nw")

        # canvas.create_window() ne redimensionne JAMAIS le widget qu'il
        # contient : sans la synchronisation ci-dessous, `conteneur` garderait
        # sa largeur naturelle et laisserait une bande grise vide a droite.
        def _synchroniser_largeur_conteneur(event):
            # <Configure> se declenche aussi pour les widgets internes a
            # `conteneur` ; on ne synchronise donc QUE sur l'evenement du
            # canvas lui-meme, sinon la largeur retomberait a celle d'un
