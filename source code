    def _afficher_cadre_methode(self):
        for cadre in self._cadres_par_methode.values():
            cadre.pack_forget()
        nom_selectionne = self.var_methode.get()
        methode_id = next((mid for mid, cle in self.methodes if self.T(cle) == nom_selectionne),
                          self.methodes[0][0])
        self._cadres_par_methode[methode_id].pack(fill=tk.X, pady=(4, 4))
        self._methode_id_courante = methode_id

    # ------------------------------------------------------------------
    # PANNEAU HYETOGRAMME - DEUX graphiques matplotlib + table exacte.
    #   Graphique 1 (gauche) : hyetogramme en barres (hauteur/pas, mm) +
    #     courbe cumulee ADIMENSIONNELLE (0 a 1, axe secondaire).
    #   Graphique 2 (droite) : comparateur adimensionnel t/duree vs
    #     P_cumulee/P_totale - 4 courbes SCS standard en arriere-plan +
    #     courbe de la methode actuellement calculee en surimpression.
    # ------------------------------------------------------------------
    def _construire_panneau_hyetogramme(self, parent):
        parent.columnconfigure(0, weight=1)
        parent.rowconfigure(1, weight=6)
        parent.rowconfigure(4, weight=1)

        self.var_hyeto_resume = tk.StringVar(value=self.T("hyeto_resume_vide"))
        label_resume = ttk.Label(parent, textvariable=self.var_hyeto_resume, style="Discret.TLabel",
                                 wraplength=900, justify="left")
        label_resume.grid(row=0, column=0, sticky="ew", pady=(0, 4))

        cadre_figure = ttk.Frame(parent)
        cadre_figure.grid(row=1, column=0, sticky="nsew")
        # constrained_layout=True : gestion automatique et continue des marges
        # (remplace tight_layout, incompatible avec une legende deportee sous
        # les axes via bbox_to_anchor - elle serait rognee a chaque redessin).
        self.figure_hyeto = Figure(figsize=(13.0, 5.2), dpi=100, constrained_layout=True)
        self.ax_hyeto = self.figure_hyeto.add_subplot(1, 2, 1)
        self.ax_hyeto2 = self.ax_hyeto.twinx()
        self.ax_compare = self.figure_hyeto.add_subplot(1, 2, 2)

        self.canvas_hyeto = FigureCanvasTkAgg(self.figure_hyeto, master=cadre_figure)
        self.canvas_hyeto.get_tk_widget().pack(fill=tk.BOTH, expand=True)
        self._dessiner_hyetogramme_vide()

        cadre_toolbar = ttk.Frame(parent)
        cadre_toolbar.grid(row=2, column=0, sticky="ew")
        self.toolbar_hyeto = NavigationToolbar2Tk(self.canvas_hyeto, cadre_toolbar)
        self.toolbar_hyeto.update()

        self.label_table_hint = ttk.Label(parent, style="Discret.TLabel")
        self._txt(self.label_table_hint, "table_hint")
        self.label_table_hint.grid(row=3, column=0, sticky="w", pady=(6, 2))

        cadre_table = ttk.Frame(parent)
        cadre_table.grid(row=4, column=0, sticky="nsew", pady=(0, 4))

        colonnes = ("pas", "debut", "fin", "duree", "fraction", "hauteur", "intensite", "cumul")
        cles_entetes = {
            "pas": "col_pas", "debut": "col_debut", "fin": "col_fin", "duree": "col_duree",
            "fraction": "col_fraction", "hauteur": "col_hauteur", "intensite": "col_intensite",
            "cumul": "col_cumul",
        }
        largeurs = {"pas": 40, "debut": 70, "fin": 60, "duree": 70, "fraction": 80,
                    "hauteur": 85, "intensite": 95, "cumul": 85}

        self.table_hyeto = ttk.Treeview(cadre_table, columns=colonnes, show="headings", height=6)
        for c in colonnes:
            self._txt(self.table_hyeto, cles_entetes[c], heading_col=c)
            self.table_hyeto.column(c, width=largeurs[c], anchor="center", stretch=True)
        scrollbar_table_v = ttk.Scrollbar(cadre_table, orient="vertical", command=self.table_hyeto.yview)
        self.table_hyeto.configure(yscrollcommand=scrollbar_table_v.set)
        self.table_hyeto.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        scrollbar_table_v.pack(side=tk.RIGHT, fill=tk.Y)
        self.table_hyeto.bind("<<TreeviewSelect>>", self._on_select_ligne_hyeto)

        self.label_unites_note = ttk.Label(parent, style="Discret.TLabel")
        self._txt(self.label_unites_note, "unites_note")
        self.label_unites_note.grid(row=5, column=0, sticky="w", pady=(2, 0))

