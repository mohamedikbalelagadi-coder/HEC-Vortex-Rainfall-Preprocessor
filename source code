    def _dessiner_courbes_scs_reference(self):
        """Trace, en arriere-plan du graphique comparateur, les 4 courbes SCS
        standard normalisees (t/24h en abscisse, P/P24h en ordonnee). Les
        courbes sont reechantillonnees toutes les 6 minutes par le meme
        interpolateur monotone que le moteur de calcul, afin que ce qui est
        AFFICHE corresponde exactement a ce qui serait CALCULE (les tables
        Types I et III ont des noeuds espaces, un trace brut donnerait une
        ligne brisee differente de la courbe reellement utilisee)."""
        temps_min = [k * 6.0 for k in range(0, 241)]   # 0 -> 1440 min
        x = [t / 1440.0 for t in temps_min]
        for type_scs in ("I", "IA", "II", "III"):
            y = interpoler_cumul_scs(type_scs, temps_min)
            y[0], y[-1] = 0.0, 1.0
            self.ax_compare.plot(x, y, color=self.COULEURS_SCS[type_scs],
                                 linewidth=1.3, alpha=0.75, linestyle="--",
                                 label="SCS Type {}".format(type_scs))

    def _configurer_axes_comparateur(self):
        self.ax_compare.set_title(self.T("titre_graph2"), fontsize=9, color=self.COULEUR_TITRE)
        self.ax_compare.set_xlabel(self.T("xlabel_t_sur_t24"))
        self.ax_compare.set_ylabel(self.T("ylabel_p_sur_p24"))
        self.ax_compare.set_xlim(0, 1)
        self.ax_compare.set_ylim(0, 1)
        self.ax_compare.grid(True, color="#e5e7eb", linewidth=0.6)
        self.ax_compare.legend(fontsize=6.5, loc="upper left")

    def _dessiner_hyetogramme_vide(self):
        self.ax_hyeto.clear()
        self.ax_hyeto2.clear()
        self.ax_hyeto.set_title(self.T("titre_graph_vide"), fontsize=10, color="#6b7280")
        self.ax_hyeto.set_xlabel(self.T("xlabel_temps_min"))
        self.ax_hyeto.set_ylabel(self.T("ylabel_hauteur_pas"), color=self.COULEUR_HYETO_BARRE)
        self.ax_hyeto2.set_ylabel("Cumul reel (mm)", color=self.COULEUR_HYETO_CUMUL)
        # Origine forcee a zero sur les trois axes : un hyetogramme se lit
        # depuis t=0 et depuis une lame nulle, jamais depuis un minimum
        # auto-echelonne par matplotlib.
        self.ax_hyeto.set_xlim(left=0)
        self.ax_hyeto.set_ylim(bottom=0)
        self.ax_hyeto2.set_ylim(bottom=0)
        self.ax_hyeto.grid(True, color="#e5e7eb", linewidth=0.6)
        self._hyeto_barres = None

        self.ax_compare.clear()
        self._dessiner_courbes_scs_reference()
        self._configurer_axes_comparateur()

        # Aucun tight_layout ici : constrained_layout (defini a la creation de
        # la figure) gere les marges en continu.
        if self.canvas_hyeto is not None:
            self.canvas_hyeto.draw_idle()

    # ------------------------------------------------------------------
    def _publier_hyetogramme(self, info):
        """Appele depuis le thread d'arriere-plan (callback_hyetogramme) : ne
        touche a AUCUN widget directement, se contente d'empiler l'info sur la
        queue thread-safe deja utilisee pour les logs et la progression."""
        self.log_queue.put(("hyeto", info))

    # ------------------------------------------------------------------
    def _afficher_hyetogramme(self, info):
        """Execute uniquement dans le thread principal (via _poll_log_queue) :
        met a jour LES DEUX graphiques matplotlib et la table Treeview avec
        les donnees EXACTES recues du moteur de calcul (aucune approximation
        supplementaire introduite cote GUI)."""
        self.dernier_hyetogramme = info
        table = info["table"]
        n = len(table)
        duree_totale_min = info.get("duree_totale_min") or (table[-1]["fin_min"] if table else 1.0)

        self.var_hyeto_resume.set(self.T(
            "hyeto_resume", methode=info["nom_methode"], lame=info["profondeur_totale_mm"],
            n=n, duree=duree_totale_min / 60.0))

        # -- Graphique 1 : barres (hauteur mm) + CUMUL REEL EN MILLIMETRES --
        temps_min = [(l["debut_min"] + l["fin_min"]) / 2.0 for l in table]
        largeurs = [max(l["duree_min"] * 0.9, 0.01) for l in table]
        hauteurs = [abs(l["hauteur_mm"]) for l in table]
        cumuls_adim = [l["cumul_adim"] for l in table]
        # La courbe cumulee est indexee sur la FIN de chaque pas (et non sur
        # son centre comme les barres) : c'est a cet instant que la lame
        # cumulee vaut reellement cumul_mm. Le point (0, 0) initial ferme la
        # courbe sur l'origine.
        x_cumul = [0.0] + [l["fin_min"] for l in table]
        y_cumul_mm = [0.0] + [l["cumul_mm"] for l in table]
        idx_pic = max(range(n), key=lambda i: hauteurs[i]) if n else None

        self.ax_hyeto.clear()
        self.ax_hyeto2.clear()
        couleurs = [self.COULEUR_HYETO_BARRE_SELECTION if i == idx_pic else self.COULEUR_HYETO_BARRE
                    for i in range(n)]
        self._hyeto_barres = self.ax_hyeto.bar(temps_min, hauteurs, width=largeurs, color=couleurs,
                                               edgecolor="none", bottom=0, label="Pluie par pas")
        self.ax_hyeto2.plot(x_cumul, y_cumul_mm, color=self.COULEUR_HYETO_CUMUL, linewidth=2.0,
                            label="Cumul reel (mm)", zorder=5)

        # Borne haute de l'axe cumule = lame totale + 5 %. Repli sur la
        # derniere valeur cumulee si la lame de reference n'est pas finie
        # (raster entierement NoData) : set_ylim(top=nan) leverait une erreur.
        lame_totale_mm = info["profondeur_totale_mm"]
        if not np.isfinite(lame_totale_mm) or lame_totale_mm <= 0:
            lame_totale_mm = y_cumul_mm[-1] if np.isfinite(y_cumul_mm[-1]) else 0.0
        self.ax_hyeto2.set_ylim(bottom=0, top=max(lame_totale_mm * 1.05, 1e-6))
        self.ax_hyeto.set_ylim(bottom=0)
        self.ax_hyeto.set_xlim(left=0)
        self.ax_hyeto2.legend(fontsize=6.5, loc="upper center", bbox_to_anchor=(0.5, -0.16),
                              frameon=False)
        # Legende des barres sur l'axe primaire, en haut a droite : les deux
        # legendes appartiennent a des axes differents (twinx) et ne peuvent
        # pas etre fusionnees sans casser le placement deja valide de celle du
        # cumul, deportee sous les axes.
        self.ax_hyeto.legend(fontsize=6.5, loc="upper right", frameon=False)

        self.ax_hyeto.set_title(self.T("titre_graph1", methode=info["nom_methode"]),
                                fontsize=9, color=self.COULEUR_TITRE)
        self.ax_hyeto.set_xlabel(self.T("xlabel_temps_min"))
        # Label dynamique : la resolution reelle du hyetogramme est desormais
        # lisible sur l'axe lui-meme (elle varie selon la methode et le pas).
        pas_min = table[0]["duree_min"]
        self.ax_hyeto.set_ylabel("Hauteur par pas de {:.1f} min (mm)".format(pas_min),
                                 color=self.COULEUR_HYETO_BARRE)
        self.ax_hyeto2.set_ylabel("Cumul reel (mm)", color=self.COULEUR_HYETO_CUMUL)
        self.ax_hyeto.tick_params(axis="y", labelcolor=self.COULEUR_HYETO_BARRE)
        self.ax_hyeto2.tick_params(axis="y", labelcolor=self.COULEUR_HYETO_CUMUL)
        self.ax_hyeto.grid(True, color="#e5e7eb", linewidth=0.6)
        if idx_pic is not None and np.isfinite(hauteurs[idx_pic]):
            self.ax_hyeto.annotate(
                self.T("annot_pic", valeur=hauteurs[idx_pic]),
                xy=(temps_min[idx_pic], hauteurs[idx_pic]), fontsize=7.5,
                color=self.COULEUR_HYETO_BARRE_SELECTION, xytext=(0, 6), textcoords="offset points",
                ha="center")

        # -- Graphique 2 : comparateur adimensionnel --
        self.ax_compare.clear()
        self._dessiner_courbes_scs_reference()
        x_norm = [0.0] + [l["fin_min"] / duree_totale_min for l in table]
        y_norm = [0.0] + cumuls_adim
        self.ax_compare.plot(x_norm, y_norm, color=self.COULEUR_TITRE, linewidth=2.2,
                             label=self.T("legende_methode_actuelle"), zorder=5)
        self._configurer_axes_comparateur()

        self.canvas_hyeto.draw_idle()

        for item in self.table_hyeto.get_children():
            self.table_hyeto.delete(item)
        for l in table:
            self.table_hyeto.insert("", tk.END, iid=str(l["pas"] - 1), values=(
                l["pas"], "{:.1f}".format(l["debut_min"]), "{:.1f}".format(l["fin_min"]),
                "{:.1f}".format(l["duree_min"]), "{:.4f}".format(l["fraction_pct"]),
                "{:.4f}".format(l["hauteur_mm"]), "{:.4f}".format(l["intensite_mmh"]),
                "{:.4f}".format(l["cumul_mm"]),
            ))

    # ------------------------------------------------------------------
    def _on_select_ligne_hyeto(self, event=None):
        """Interactivite table <-> graphique : selectionner une ligne de la
        table met en evidence le bloc correspondant dans le graphique 1, sans
        tout redessiner (juste la couleur des barres)."""
        if not self._hyeto_barres:
            return
        selection = self.table_hyeto.selection()
        if not selection:
            return
        try:
            idx = int(selection[0])
        except ValueError:
            return
        idx_pic = None
        if self.dernier_hyetogramme:
            hauteurs = [l["hauteur_mm"] for l in self.dernier_hyetogramme["table"]]
            if hauteurs:
                idx_pic = max(range(len(hauteurs)), key=lambda i: hauteurs[i])
        for i, patch in enumerate(self._hyeto_barres):
            if i == idx:
                patch.set_color(self.COULEUR_HYETO_BARRE_SELECTION)
            elif i == idx_pic:
                patch.set_color(self.COULEUR_HYETO_BARRE_PIC)
            else:
                patch.set_color(self.COULEUR_HYETO_BARRE)
        self.canvas_hyeto.draw_idle()

    # ------------------------------------------------------------------
