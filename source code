    def __init__(self, root):
        self.root = root
        # `_langue_code` est un miroir Python PUR de la langue active.
        # T() le lit a la place de la tk.StringVar : une StringVar ne peut
        # pas etre interrogee depuis un thread secondaire (RuntimeError
        # "main thread is not in main loop"), or le thread de traitement
        # appelle T() pour composer ses messages.
        self._langue_code = "fr"
        self.langue = tk.StringVar(value="fr")
        self._registre_textes = []   # [(widget, cle, sous_element_ou_None), ...]

        self.root.title(self.T("titre_fenetre"))
        self.root.geometry("1440x900")
        self.root.minsize(1100, 700)
        self.root.configure(bg=self.COULEUR_FOND)

        self.log_queue = queue.Queue()
        self.traitement_en_cours = False
        self.dernier_hyetogramme = None   # dernier dict recu via callback_hyetogramme
        self._hyeto_barres = None         # patches matplotlib (selection interactive)
        self.canvas_hyeto = None

        self._construire_style()
        self._construire_interface()
        self._poll_log_queue()
        self.root.protocol("WM_DELETE_WINDOW", self._fermer)

    # ------------------------------------------------------------------
    # TRADUCTION - T(cle) resout selon la langue active ; _txt() applique le
    # texte ET enregistre le widget pour re-traduction lors du basculement.
    # ------------------------------------------------------------------
    def T(self, cle, **kwargs):
        entree = TRAD.get(cle)
        if entree is None:
            return cle
        texte = entree.get(self._langue_code, entree.get("fr", cle))
        if kwargs:
            try:
                texte = texte.format(**kwargs)
            except (KeyError, IndexError, ValueError):
                pass
        return texte

    def _txt(self, widget, cle, heading_col=None):
        """Definit le texte initial d'un widget a partir de sa cle de
        traduction ET enregistre (widget, cle, heading_col) pour que
        _rafraichir_langue() puisse le remettre a jour plus tard."""
        if heading_col is not None:
            widget.heading(heading_col, text=self.T(cle))
        else:
            widget.configure(text=self.T(cle))
        self._registre_textes.append((widget, cle, heading_col))

    def _basculer_langue(self):
        self._langue_code = "en" if self._langue_code == "fr" else "fr"
        self.langue.set(self._langue_code)
        self._rafraichir_langue()

    def _rafraichir_langue(self):
        self._langue_code = self.langue.get() or "fr"
        self.root.title(self.T("titre_fenetre"))
        for widget, cle, heading_col in self._registre_textes:
            try:
                if heading_col is not None:
                    widget.heading(heading_col, text=self.T(cle))
                else:
                    widget.configure(text=self.T(cle))
            except tk.TclError:
                pass  # widget detruit entre-temps - ignorer
        self.bouton_langue.configure(text=self.T("bouton_langue"))
        if not self.traitement_en_cours:
            self.bouton_lancer.configure(text=self.T("bouton_lancer"))
        # Combobox des methodes : reconstruire la liste de valeurs traduites
        # tout en conservant la selection courante (par identifiant, pas par
        # libelle, puisque le libelle change de langue).
        methode_id_selection = getattr(self, "_methode_id_courante", self.methodes[0][0])
        self.combo_methode["values"] = [self.T(cle) for _, cle in self.methodes]
        for mid, cle in self.methodes:
            if mid == methode_id_selection:
                self.var_methode.set(self.T(cle))
                break
        if self.dernier_hyetogramme is None:
            self.var_hyeto_resume.set(self.T("hyeto_resume_vide"))
            self._dessiner_hyetogramme_vide()
        else:
            self._afficher_hyetogramme(self.dernier_hyetogramme)

