# 3. ORCHESTRATION DU PIPELINE COMPLET
# ============================================================================

def calculer_table_hyetogramme(fractions, minutes_cumulees, profondeur_totale_mm):
    """Construit, a partir des fractions temporelles et de la lame totale de
    reference (mm), le detail EXACT pas-par-pas du hyetogramme : bornes de
    temps (min), fraction (%), hauteur (mm), intensite (mm/h) et cumul (mm
    ET adimensionnel P/Ptotale). Aucune valeur n'est arrondie avant
    l'affichage - le calcul se fait en double precision, l'arrondi
    n'intervient qu'au moment du formatage texte."""
    n = len(fractions)
    if minutes_cumulees is None:
        minutes_cumulees = [60 * (i + 1) for i in range(n)]
    debuts = [0] + list(minutes_cumulees[:-1])

    lignes = []
    cumul_mm = 0.0
    cumul_frac = 0.0
    for i in range(n):
        debut_min = debuts[i]
        fin_min = minutes_cumulees[i]
        duree_min = fin_min - debut_min
        hauteur_mm = fractions[i] * profondeur_totale_mm
        intensite_mmh = (hauteur_mm / (duree_min / 60.0)) if duree_min > 0 else float("nan")
        cumul_mm += hauteur_mm
        cumul_frac += fractions[i]
        lignes.append({
            "pas": i + 1,
            "debut_min": debut_min,
            "fin_min": fin_min,
            "duree_min": duree_min,
            "fraction_pct": fractions[i] * 100.0,
            "hauteur_mm": hauteur_mm,
            "intensite_mmh": intensite_mmh,
            "cumul_mm": cumul_mm,
            "cumul_adim": cumul_frac,
        })
    return lignes


def calculer_distribution_temporelle(methode_id, params_methode, log=None):
    """Aiguillage unique vers la methode de distribution demandee.
    Renvoie (fractions, minutes_cumulees, nom_methode)."""
    moteur = MoteurDistributionTemporelle
    if methode_id in ("I", "IA", "II", "III"):
        fractions, minutes = moteur.methode_scs_officiel(
            methode_id, params_methode.get("pas_min"), log=log)
        nom = "SCS Type {} (NRCS)".format(methode_id)
    elif methode_id == "B":
        fractions, minutes = moteur.methode_b_scs_manuel(
            params_methode.get("texte_manuel", ""), params_methode.get("pas_min", 60.0), log=log)
        nom = "SCS (saisie manuelle)"
    elif methode_id == "C":
        fractions, minutes = moteur.methode_c_blocs_alternes(
            params_methode.get("a"), params_methode.get("b"),
            params_methode.get("duree_h"), params_methode.get("pas_min"), log=log)
        nom = "Methode des blocs alternes (a={}, b={})".format(
            params_methode.get("a"), params_methode.get("b"))
    elif methode_id == "D":
        fractions, minutes = moteur.methode_d_triangulaire(
            params_methode.get("duree_h"), params_methode.get("r"),
            params_methode.get("pas_min", 60.0), log=log)
        nom = "Hyetogramme triangulaire (r={})".format(params_methode.get("r"))
    elif methode_id == "E":
        fractions, minutes = moteur.methode_e_historique(
            params_methode.get("chemin_fichier"), params_methode.get("pas_min", 60.0), log=log)
        nom = "Pluie historique ({})".format(Path(params_methode.get("chemin_fichier")).name)
    else:
        raise ErreurTraitement("Methode de distribution temporelle inconnue : {}".format(methode_id))
    return fractions, minutes, nom


def executer_traitement(chemin_raster, chemin_shp, dossier_sortie,
                        marge_m, stress_pct, faire_zero_padding,
                        methode_id, params_methode, log,
                        callback_progression=None, callback_hyetogramme=None):
    """Orchestration complete : lecture -> stress -> zero-padding ->
    distribution temporelle -> ecriture. `log` est appele pour chaque ligne
    de progression (thread-safe cote appelant). `callback_progression`
    (optionnel) recoit un pourcentage 0-100. `callback_hyetogramme`
    (optionnel) recoit un dict decrivant EXACTEMENT le hyetogramme qui va
    etre ecrit - utilise par la GUI pour tracer les 2 graphiques de controle
    avant meme que l'ecriture des rasters ne demarre."""

    prepro = PreprocesseurRaster(log, callback_progression=callback_progression)

    if faire_zero_padding and not chemin_shp:
        raise ErreurTraitement(
            "Le Zero-Padding est active mais aucun shapefile de bassin n'est selectionne.")
    if not dossier_sortie:
        raise ErreurTraitement("Aucun dossier de sortie selectionne.")

    dossier_sortie = Path(dossier_sortie)
    dossier_sortie.mkdir(parents=True, exist_ok=True)
    log("Dossier de sortie : {}".format(dossier_sortie))
    log("")

    # --- 0. Lecture ---
    matrice, profil, transform, crs, nodata = prepro.lire_raster(chemin_raster)
    log("")

    # --- 1. Stress climatique ---
    matrice = prepro.appliquer_stress_climatique(matrice, nodata, stress_pct)

    # --- 2. Zero-padding ---
    if faire_zero_padding:
        matrice, masque_reference = prepro.appliquer_zero_padding(
            matrice, transform, crs, nodata, chemin_shp, marge_m)
        nodata_final = None
        masque_nodata_sortie = None
    else:
        log("Zero-Padding desactive - raster utilise tel quel (NoData conserve si present).")
        masque_nd = prepro.masque_nodata(matrice, nodata)
        if masque_nd.any():
            nodata_final = nodata if nodata is not None else float("nan")
            masque_nodata_sortie = masque_nd
            masque_reference = ~masque_nd
            log("  {} pixel(s) NoData detecte(s) : ils seront reecrits comme NoData "
                "(valeur {}) dans CHAQUE grille de sortie.".format(int(masque_nd.sum()), nodata_final))
        else:
            nodata_final = nodata
            masque_nodata_sortie = None
            masque_reference = None
        log("")

    # --- 3. Distribution temporelle ---
    fractions, minutes, nom_methode = calculer_distribution_temporelle(
        methode_id, params_methode, log=log)

    # Lame de reference : moyenne sur les pixels PERTINENTS uniquement
    # (interieur du bassin apres zero-padding, ou pixels valides sinon).
    # Auparavant la moyenne incluait les zeros exterieurs, ce qui divisait la
    # lame affichee par la proportion de la fenetre occupee par le bassin.
    if masque_reference is not None and masque_reference.any():
        pixels_reference = matrice[masque_reference]
    else:
        pixels_reference = matrice.ravel()
    profondeur_totale_mm = float(np.mean(pixels_reference)) if pixels_reference.size else float("nan")
    # Garde-fou : sans ce controle, une lame NaN (aucun pixel valide) ou nulle
    # se propagerait a toutes les grilles, qui seraient ecrites sans erreur
    # mais inexploitables dans HEC-Vortex.
    if not np.isfinite(profondeur_totale_mm) or profondeur_totale_mm <= 0:
        raise ErreurTraitement(
            "Aucune donnee de pluie valide sur la zone etudiee. Verifiez le masque du bassin.")
    log("Lame de reference du hyetogramme : {:.4f} mm (moyenne sur {} pixel(s) {}).".format(
        profondeur_totale_mm, int(pixels_reference.size),
        "interieurs au bassin" if faire_zero_padding else "valides"))
    log("")
    del pixels_reference

    duree_totale_min = minutes[-1] if minutes else (len(fractions) * 60)

    if callback_hyetogramme is not None:
        table_hyeto = calculer_table_hyetogramme(fractions, minutes, profondeur_totale_mm)
        callback_hyetogramme({
            "nom_methode": nom_methode,
            "methode_id": methode_id,
            "fractions": list(fractions),
            "minutes_cumulees": list(minutes) if minutes is not None else None,
            "duree_totale_min": duree_totale_min,
            "profondeur_totale_mm": profondeur_totale_mm,
            "table": table_hyeto,
            "unites": {
                "temps": "min", "hauteur": "mm", "intensite": "mm/h",
                "fraction": "%", "cumul": "mm",
            },
        })

    chemins = prepro.generer_grilles_temporelles(
        matrice, profil, transform, crs, nodata_final, dossier_sortie,
        fractions, minutes, nom_methode, masque_nodata=masque_nodata_sortie)

    log("=" * 60)
    log("TRAITEMENT TERMINE AVEC SUCCES")
    log("=" * 60)
    log("Methode             : {}".format(nom_methode))
    log("Grilles generees    : {} fichiers".format(len(chemins)))
    log("Duree totale        : {} min ({:.2f} h)".format(
        int(duree_totale_min), duree_totale_min / 60.0))
    log("Dossier complet     : {}".format(dossier_sortie.resolve()))

    return chemins


