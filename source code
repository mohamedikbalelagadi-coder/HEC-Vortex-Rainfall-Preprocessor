def _controler_tables_scs():
    """Controle d'integrite execute a l'import : chaque table doit avoir des
    listes de meme longueur, un temps strictement croissant de 0 a 24 h et un
    cumul non decroissant de 0.0 a 1.0. Une table corrompue lors d'une edition
    manuelle serait ainsi detectee immediatement, et non silencieusement."""
    for type_scs, (temps_h, cumul) in TABLES_SCS.items():
        if len(temps_h) != len(cumul) or len(temps_h) < 2:
            raise ErreurTraitement(
                "[Table SCS {}] Longueurs incoherentes : {} temps / {} cumuls.".format(
                    type_scs, len(temps_h), len(cumul)))
        if abs(temps_h[0]) > 1e-9 or abs(temps_h[-1] - 24.0) > 1e-9:
            raise ErreurTraitement(
                "[Table SCS {}] Le temps doit aller de 0.0 h a 24.0 h.".format(type_scs))
        if abs(cumul[0]) > 1e-9 or abs(cumul[-1] - 1.0) > 1e-9:
            raise ErreurTraitement(
                "[Table SCS {}] Le cumul doit aller de 0.0 a 1.0.".format(type_scs))
        for k in range(1, len(temps_h)):
            if temps_h[k] <= temps_h[k - 1]:
                raise ErreurTraitement(
                    "[Table SCS {}] Temps non strictement croissant a l'indice {}.".format(type_scs, k))
            if cumul[k] < cumul[k - 1]:
                raise ErreurTraitement(
                    "[Table SCS {}] Cumul decroissant a l'indice {}.".format(type_scs, k))


