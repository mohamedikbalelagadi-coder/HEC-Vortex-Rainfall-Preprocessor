MODULES_OBLIGATOIRES = ("rasterio", "geopandas", "numpy", "matplotlib")
MODULES_OPTIONNELS = ("scipy",)


def verifier_dependances():
    """Renvoie (manquantes_obligatoires, manquantes_optionnelles). scipy est
    desormais OPTIONNEL : sans lui l'interpolation des tables SCS retombe sur
    numpy.interp (lineaire, monotone), ce qui reste correct - l'application
    n'a donc plus de raison de refuser de demarrer."""
    manquantes = []
    optionnelles = []
    for module in MODULES_OBLIGATOIRES:
        try:
            __import__(module)
        except ImportError:
            manquantes.append(module)
    for module in MODULES_OPTIONNELS:
        try:
            __import__(module)
        except ImportError:
            optionnelles.append(module)
    return manquantes, optionnelles


def main():
    # Controle d'integrite des tables SCS : execute ICI (et non a l'import) de
    # facon a pouvoir afficher une boite de dialogue lisible en version
    # --windowed, ou aucun message console n'est visible.
    try:
        _controler_tables_scs()
    except Exception as e:
        root_tmp = tk.Tk()
        root_tmp.withdraw()
        messagebox.showerror(
            "Tables SCS corrompues",
            "Le controle d'integrite des tables de distribution SCS a echoue :\n\n{}\n\n"
            "Le fichier source a probablement ete modifie. Restaure une version saine "
            "de hec_vortex_preprocesseur.py avant de relancer l'application.".format(e))
        root_tmp.destroy()
        sys.exit(1)

    manquantes, optionnelles = verifier_dependances()
    if manquantes:
        root_tmp = tk.Tk()
        root_tmp.withdraw()
        messagebox.showerror(
            "Dependances manquantes",
            "Modules Python manquants : {}\n\nInstalle-les avec :\npip install {}".format(
                ", ".join(manquantes), " ".join(manquantes)))
        root_tmp.destroy()
        sys.exit(1)

    root = tk.Tk()
    app = HecVortexPreprocessorApp(root)
    if optionnelles:
        app._log("scipy n'est pas installe : interpolation lineaire (numpy.interp) utilisee pour "
                 "les tables SCS au lieu de PCHIP. Resultat valide, mais legerement moins lisse.")
        app._log("Installation recommandee : pip install scipy")
        app._log("")
    root.mainloop()


if __name__ == "__main__":
    main()
