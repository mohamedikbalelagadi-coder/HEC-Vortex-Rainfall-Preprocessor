# Une exception levee a l'import tuerait le processus avant toute fenetre ;
# en executable --windowed (PyInstaller) il n'y a ni console ni traceback
# visible, l'utilisateur ne verrait qu'un plantage silencieux. Le controle
# est donc effectue au debut de main(), ou l'erreur peut etre presentee
# dans une messagebox.


def interpoler_cumul_scs(type_scs, temps_min_cibles, log=None):
    """Interpole la courbe cumulee SCS d'un type donne aux instants demandes
    (en MINUTES). Utilise PchipInterpolator (monotone, sans oscillation entre
    les noeuds) si scipy est disponible, sinon numpy.interp (lineaire par
    morceaux, monotone par construction).

    Robustesse : toute valeur non finie renvoyee par l'interpolateur (cas
    limite aux bornes avec extrapolate=False) est remplacee par la valeur
    lineaire equivalente, puis la serie est forcee non decroissante et bornee
    a [0, 1]. Sans ce filet, un NaN traversait le controle de monotonie
    (NaN < x est toujours faux) et etait converti silencieusement en 0.0,
    creant un trou dans la courbe cumulee."""
    type_scs = (type_scs or "").strip().upper()
    if type_scs not in TABLES_SCS:
        raise ErreurTraitement(
            "[SCS] Type de distribution inconnu : '{}' (attendu I, IA, II ou III).".format(type_scs))

    temps_h_noeuds, cumul_noeuds = TABLES_SCS[type_scs]
    temps_min_noeuds = [t * 60.0 for t in temps_h_noeuds]
    cibles = [float(t) for t in temps_min_cibles]

    valeurs_lineaires = [float(v) for v in np.interp(cibles, temps_min_noeuds, cumul_noeuds)]
    if _SCIPY_DISPONIBLE:
        interpolateur = PchipInterpolator(temps_min_noeuds, cumul_noeuds, extrapolate=False)
        valeurs = []
        for t, v_lin in zip(cibles, valeurs_lineaires):
            v = float(interpolateur(t))
            valeurs.append(v if np.isfinite(v) else v_lin)
    else:
        valeurs = valeurs_lineaires
        if log is not None:
            log("  [SCS Type {}] scipy indisponible - interpolation lineaire (numpy.interp) "
                "utilisee a la place de PCHIP (monotone dans les deux cas).".format(type_scs))

    for k in range(len(valeurs)):
        if not np.isfinite(valeurs[k]):
            valeurs[k] = valeurs_lineaires[k]
        valeurs[k] = min(1.0, max(0.0, valeurs[k]))
        if k > 0 and valeurs[k] < valeurs[k - 1]:
            valeurs[k] = valeurs[k - 1]
    return valeurs


# ============================================================================
# 1. MOTEUR DE DISTRIBUTION TEMPORELLE - logique mathematique pure
# ============================================================================
# Chaque methode renvoie un tuple (fractions, minutes_cumulees) :
#   - fractions        : liste de floats sommant a 1.0 (a 1e-12 pres apres
#                         normalisation), dans l'ordre chronologique.
#   - minutes_cumulees : liste d'entiers, temps cumule (minutes) a la FIN de
#                         chaque pas - utilisee pour calculer l'horodatage de
#                         chaque fichier de sortie. Tous les fichiers sont
#                         nommes pluie_YYYY-MM-DD_HHMM.tif (horodatage = FIN
#                         du pas), a partir d'une date de reference
#                         conventionnelle (voir EPOCH_HYETOGRAMME).
#   TOUTES les methodes renvoient desormais des minutes explicites (les
#   methodes B, D et E renvoyaient None, ce qui forcait en aval un pas
#   horaire fictif : horodatages DSS faux des que le pas reel n'etait pas
#   de 60 min).
# ============================================================================

class MoteurDistributionTemporelle:
    """Regroupe les methodes de distribution temporelle de la pluie.
    Toutes les methodes sont des classmethods pures (aucun I/O raster ici),
    ce qui les rend testables independamment du pipeline spatial."""

    # ------------------------------------------------------------------
    @staticmethod
    def _normaliser(fractions, description):
        """Renormalise une liste de valeurs pour qu'elle somme exactement a
        1.0, sans exiger qu'elle en soit proche au depart. Utilisee pour les
        methodes dont les valeurs brutes sont des quantites physiques
        (hauteurs, aires, pourcentages 0-100...) plutot que des fractions
        deja normalisees par l'utilisateur."""
        if not fractions:
            raise ErreurTraitement("[{}] Liste de fractions vide.".format(description))
        somme = float(sum(fractions))
        if not np.isfinite(somme):
            raise ErreurTraitement(
                "[{}] Somme non finie (NaN/inf) - calcul interrompu.".format(description))
        if somme <= 0:
            raise ErreurTraitement(
                "[{}] La somme des valeurs doit etre strictement positive (obtenue : {}).".format(
                    description, somme))
        return [f / somme for f in fractions]

    @staticmethod
    def _valider_nombre(valeur, nom_champ):
        """Valide qu'une valeur est bien un nombre utilisable (defense en
        profondeur : la GUI convertit deja les saisies en float avant
        d'appeler le moteur, mais ces methodes doivent rester sures si
        appelees directement, p.ex. depuis un futur script/CLI)."""
        if valeur is None:
            raise ErreurTraitement("[{}] Valeur manquante.".format(nom_champ))
        if isinstance(valeur, bool) or not isinstance(valeur, (int, float)):
            try:
                valeur = float(str(valeur).strip().replace(",", "."))
            except (ValueError, TypeError):
                raise ErreurTraitement(
                    "[{}] '{}' n'est pas un nombre valide.".format(nom_champ, valeur))
        valeur = float(valeur)
        if not np.isfinite(valeur):
            raise ErreurTraitement("[{}] Valeur non finie (NaN/inf).".format(nom_champ))
        return valeur

    # ------------------------------------------------------------------
    @staticmethod
    def _valider_pas_min(pas_min, description):
        """Garde-fou commun a TOUTES les methodes a pas de temps dynamique :
        le pas doit etre >= 1 minute. Les fichiers de sortie sont horodates
        a la minute pres (pluie_YYYY-MM-DD_HHMM.tif) ; avec un pas < 1 min,
        deux pas consecutifs pourraient arrondir sur la MEME minute et le
        second fichier ecraserait alors silencieusement le premier."""
        if pas_min < 1.0:
            raise ErreurTraitement(
                "[{}] Le pas de temps doit etre >= 1 minute (resolution des noms de "
                "fichiers pluie_YYYY-MM-DD_HHMM.tif) - recu {} min. Un pas < 1 min provoquerait "
                "des collisions de noms de fichiers et une perte silencieuse de pas de "
                "temps.".format(description, pas_min))

    @staticmethod
    def _valider_nombre_de_pas(n, description):
        if n < 1:
            raise ErreurTraitement(
                "[{}] Duree / pas de temps donne moins d'un intervalle.".format(description))
        if n > NB_PAS_MAX:
            raise ErreurTraitement(
                "[{}] {} intervalles calcules (duree/pas) - c'est excessif (plus de {} rasters "
                "a generer). Augmente le pas de temps.".format(description, n, NB_PAS_MAX))

    @staticmethod
    def _verifier_horodatages(temps_min, description):
        """Verifie que les horodatages (minutes, arrondis a l'entier) sont
        STRICTEMENT croissants. Deux pas tombant sur la meme minute
        produiraient deux fois le meme nom de fichier, donc un ecrasement
        silencieux d'une grille par la suivante."""
        for k in range(1, len(temps_min)):
            if temps_min[k] <= temps_min[k - 1]:
                raise ErreurTraitement(
                    "[{}] Horodatages non strictement croissants (pas {} -> pas {} : {} min -> "
                    "{} min) - arret pour eviter d'ecraser un fichier de sortie.".format(
                        description, k, k + 1, temps_min[k - 1], temps_min[k]))

    @classmethod
    def _grille_de_temps(cls, duree_min, pas_min, description, log=None):
        """Construit la grille temporelle commune a toutes les methodes a pas
        dynamique : n pas couvrant EXACTEMENT la duree demandee (pas effectif
        = duree/n), afin d'eviter toute derive silencieuse de la duree totale
        quand la duree n'est pas un multiple exact du pas demande.
        Renvoie (n, pas_min_effectif, temps_min_arrondis)."""
        n = int(round(duree_min / pas_min))
        cls._valider_nombre_de_pas(n, description)
        pas_min_effectif = duree_min / n
        if log is not None and abs(pas_min_effectif - pas_min) > 1e-6:
            log("  [{}] Pas de temps ajuste : {:.4f} min demande -> {:.4f} min effectif "
                "(pour que {} pas couvrent exactement {:.1f} min).".format(
                    description, pas_min, pas_min_effectif, n, duree_min))
        temps_min = [int(round(k * pas_min_effectif)) for k in range(0, n + 1)]
        cls._verifier_horodatages(temps_min, description)
        return n, pas_min_effectif, temps_min

    # ------------------------------------------------------------------
    @classmethod
    def methode_scs_officiel(cls, type_scs: str, pas_min: float, log=None):
        """Methodes A - Distributions synthetiques 24 h NRCS/SCS (Type I, IA,
        II ou III). Voir TABLES_SCS en tete de fichier pour la provenance
        exacte de chaque table.

        Algorithme (pas de temps DYNAMIQUE) :
          1. Les noeuds (TEMPS_H, CUMUL) sont interpoles par une fonction
             MONOTONE (PCHIP si scipy est disponible, sinon lineaire).
          2. La courbe interpolee est echantillonnee exactement aux pas de
             temps demandes, avec un pas EFFECTIF ajuste pour que n pas
             couvrent exactement 24 h pile.
          3. Les cumuls echantillonnes sont forces a 0.0 au debut et 1.0 a la
             fin, contraints non decroissants, puis convertis en increments
             renormalises a somme = 1.0 exactement.
        """
        type_scs = (type_scs or "").strip().upper()
        if type_scs not in TABLES_SCS:
            raise ErreurTraitement(
                "[SCS] Type de distribution inconnu : '{}' (attendu I, IA, II ou III).".format(type_scs))
        description = "SCS Type {}".format(type_scs)
        pas_min = cls._valider_nombre(pas_min, description + " - pas de temps (min)")
        cls._valider_pas_min(pas_min, description)

        duree_min = 24.0 * 60.0
        n, pas_min_effectif, temps_min_echant = cls._grille_de_temps(
            duree_min, pas_min, description, log=log)

        # On interpole sur les temps EXACTS (non arrondis) pour ne pas
        # introduire de bruit sur la forme de la courbe ; les temps arrondis
        # ne servent qu'a l'horodatage des fichiers.
        temps_exacts = [k * pas_min_effectif for k in range(0, n + 1)]
        cumul_echant = interpoler_cumul_scs(type_scs, temps_exacts, log=log)

        cumul_echant[0] = 0.0
        cumul_echant[-1] = 1.0
        for k in range(1, len(cumul_echant)):
            if cumul_echant[k] < cumul_echant[k - 1]:
                cumul_echant[k] = cumul_echant[k - 1]

        increments = [cumul_echant[k] - cumul_echant[k - 1] for k in range(1, len(cumul_echant))]
        fractions = cls._normaliser(increments, description)
        return fractions, temps_min_echant[1:]

    # ------------------------------------------------------------------
    @classmethod
    def methode_b_scs_manuel(cls, texte_saisi: str, pas_min: float = 60.0, log=None):
        """Methode B - 24 valeurs saisies manuellement par l'utilisateur,
        separees par des virgules (une par pas de temps). La somme est
        acceptee si elle vaut ~1.0 (fractions) OU ~100 (pourcentages) :
        l'unite est auto-detectee puis la liste est renormalisee a 1.0 sans
        jamais changer la FORME de la distribution."""
        if not texte_saisi or not texte_saisi.strip():
            raise ErreurTraitement(
                "[SCS manuel] Aucune valeur saisie. Colle 24 valeurs separees par des virgules.")

        description = "SCS manuel"
        pas_min = cls._valider_nombre(pas_min, description + " - pas de temps (min)")
        cls._valider_pas_min(pas_min, description)

        # Separateurs acceptes : virgule, point-virgule, tabulation, espace,
        # retour a la ligne. La virgule decimale n'est donc PAS acceptee ici
        # (elle serait indistinguable d'un separateur de valeurs) : utiliser
        # le point decimal.
        morceaux = [m for m in re.split(r"[,;\t\r\n ]+", texte_saisi.strip()) if m != ""]
        valeurs = []
        for i, morceau in enumerate(morceaux, start=1):
            try:
                valeurs.append(float(morceau))
            except ValueError:
                raise ErreurTraitement(
                    "[SCS manuel] Valeur n {} invalide : '{}' n'est pas un nombre (utilise le "
                    "point comme separateur decimal).".format(i, morceau))

        if len(valeurs) != 24:
            raise ErreurTraitement(
                "[SCS manuel] {} valeur(s) trouvee(s), 24 attendues exactement.".format(len(valeurs)))
        if any(v < 0 for v in valeurs):
            raise ErreurTraitement("[SCS manuel] Les valeurs doivent toutes etre positives ou nulles.")

        somme = sum(valeurs)
        if abs(somme - 1.0) <= 1e-3:
            pass
        elif abs(somme - 100.0) <= 1e-1:
            if log is not None:
                log("  [SCS manuel] Somme = {:.4f} -> valeurs interpretees comme des POURCENTAGES "
                    "et renormalisees a 1.0.".format(somme))
        else:
            raise ErreurTraitement(
                "[SCS manuel] La somme des 24 valeurs vaut {:.6f} ; attendu 1.0 (fractions, "
                "+/- 0.001) ou 100 (pourcentages, +/- 0.1).".format(somme))

        fractions = cls._normaliser(valeurs, description)
        n = len(fractions)
        temps_min = [int(round(k * pas_min)) for k in range(0, n + 1)]
        cls._verifier_horodatages(temps_min, description)
        return fractions, temps_min[1:]

    # ------------------------------------------------------------------
    @classmethod
    def methode_c_blocs_alternes(cls, a: float, b: float, duree_h: float, pas_min: float, log=None):
        """Methode C - Methode des blocs alternes, a partir d'une loi
        Intensite-Duree I(t) = a . t^-b (I en mm/h, t en MINUTES depuis le
        debut de l'episode). Recalibrer a/b si ta courbe IDF est parametree
        en heures.

        Algorithme (Chow, Maidment & Mays, "Applied Hydrology") :
          1. Hauteur cumulee P(t_k) = I(t_k) * (t_k / 60) pour chaque pas k
             (P(0) = 0 par convention, la formule etant singuliere en t=0).
          2. Increments dP_k = P(t_k) - P(t_{k-1}), tries par ordre decroissant.
          3. Rearrangement : le plus grand increment est place au CENTRE
             de la duree totale (indice (n-1)//2, 0-indexe), puis les
             increments suivants alternent a droite puis a gauche par ordre
             decroissant.
          Absence de debordement d'indice : pour tout n >= 1, le nombre de
          creneaux a droite du centre (n-1-centre) et a gauche (centre) est
          exactement egal au nombre de valeurs alternees affectees a chaque
          cote (ceil/floor de (n-1)/2).

        Remarque sur 'a' : les increments sont tous proportionnels a 'a', qui
        s'annule donc exactement lors de la renormalisation finale. 'a' est
        demande pour rester coherent avec la formule IDF affichee, mais SEUL
        'b' influence la forme du hyetogramme normalise."""
        description = "Blocs alternes"
        a = cls._valider_nombre(a, description + " - parametre a (mm/h, a t=1 min)")
        b = cls._valider_nombre(b, description + " - parametre b (exposant, sans unite)")
        duree_h = cls._valider_nombre(duree_h, description + " - duree totale (h)")
        pas_min = cls._valider_nombre(pas_min, description + " - pas de temps (min)")

        if a <= 0:
            raise ErreurTraitement("[Blocs alternes] Le parametre 'a' doit etre strictement positif.")
        if duree_h <= 0:
            raise ErreurTraitement("[Blocs alternes] La duree totale doit etre strictement positive.")
        cls._valider_pas_min(pas_min, description)

        duree_min = duree_h * 60.0
        n, pas_min_effectif, temps_min = cls._grille_de_temps(duree_min, pas_min, description, log=log)

        profondeurs_cumulees = [0.0]
        for k in range(1, n + 1):
            t = k * pas_min_effectif              # minutes (valeur exacte)
            intensite = a * (t ** (-b))           # mm/h
            profondeurs_cumulees.append(intensite * (t / 60.0))   # mm

        increments = [profondeurs_cumulees[k] - profondeurs_cumulees[k - 1] for k in range(1, n + 1)]
        if any(inc < 0 for inc in increments):
            raise ErreurTraitement(
                "[Blocs alternes] La loi I=a.t^-b donne une hauteur cumulee non croissante avec ces "
                "parametres (a={}, b={}) - verifie le signe/la valeur de b.".format(a, b))

        increments_tries = sorted(increments, reverse=True)
        resultat = [0.0] * n
        centre = (n - 1) // 2
        resultat[centre] = increments_tries[0]
        gauche = centre
        droite = centre
        vers_la_droite = True
        for valeur in increments_tries[1:]:
            if vers_la_droite:
                droite += 1
                resultat[droite] = valeur
            else:
                gauche -= 1
                resultat[gauche] = valeur
            vers_la_droite = not vers_la_droite

        fractions = cls._normaliser(resultat, description)
        return fractions, temps_min[1:]

    # ------------------------------------------------------------------
    @classmethod
    def methode_d_triangulaire(cls, duree_h: float, r: float, pas_min: float = 60.0, log=None):
        """Methode D - Hyetogramme triangulaire. Base = duree totale (h),
        sommet du triangle a t = r * duree (0 < r < 1). Integration exacte de
        l'aire sous le triangle sur chaque pas (hauteur arbitraire : le
        resultat est normalise a la fin). Le pas de temps est desormais
        parametrable (il etait fige a 1 h, ce qui faussait les horodatages
        des grilles pour toute autre resolution)."""
        description = "Triangulaire"
        duree_h = cls._valider_nombre(duree_h, description + " - duree totale (h)")
        r = cls._valider_nombre(r, description + " - coefficient de pointe r (0-1)")
        pas_min = cls._valider_nombre(pas_min, description + " - pas de temps (min)")
        if duree_h <= 0:
            raise ErreurTraitement("[Triangulaire] La duree totale doit etre strictement positive.")
        if not (0.0 < r < 1.0):
            raise ErreurTraitement("[Triangulaire] Le coefficient de pointe r doit etre strictement entre 0 et 1.")
        cls._valider_pas_min(pas_min, description)

        duree_min = duree_h * 60.0
        n, pas_min_effectif, temps_min = cls._grille_de_temps(duree_min, pas_min, description, log=log)
        t_pic_min = r * duree_min

        def aire_cumulee(t):
            t = min(max(t, 0.0), duree_min)
            if t <= t_pic_min:
                return (t ** 2) / (2.0 * t_pic_min) if t_pic_min > 0 else 0.0
            return duree_min / 2.0 - ((duree_min - t) ** 2) / (2.0 * (duree_min - t_pic_min))

        cumul = [aire_cumulee(k * pas_min_effectif) for k in range(0, n + 1)]
        increments = [cumul[k] - cumul[k - 1] for k in range(1, len(cumul))]
        fractions = cls._normaliser(increments, description)
        return fractions, temps_min[1:]

    # ------------------------------------------------------------------
    @classmethod
    def methode_e_historique(cls, chemin_fichier, pas_min: float = 60.0, log=None):
        """Methode E - Fractions lues dans un fichier .txt/.csv (une valeur
        par ligne ; si la ligne contient plusieurs colonnes, la DERNIERE est
        utilisee). Pourcentages ou fractions : l'unite importe peu, la serie
        est renormalisee a 1.0. Le pas de temps entre deux valeurs est
        desormais parametrable (il etait suppose horaire)."""
        description = "Pluie historique"
        if not chemin_fichier or not Path(chemin_fichier).exists():
            raise ErreurTraitement("[Pluie historique] Fichier introuvable : {}".format(chemin_fichier))
        pas_min = cls._valider_nombre(pas_min, description + " - pas de temps (min)")
        cls._valider_pas_min(pas_min, description)

        chemin_fichier = Path(chemin_fichier)
        with open(chemin_fichier, "r", encoding="utf-8-sig", errors="replace") as f:
            contenu = f.read()

        valeurs = []
        lignes = [l for l in contenu.splitlines() if l.strip() != ""]
        for i, ligne in enumerate(lignes, start=1):
            morceaux = [m for m in re.split(r"[,;\t ]+", ligne.strip()) if m != ""]
            if not morceaux:
                continue
            dernier = morceaux[-1].replace(",", ".")
            try:
                valeurs.append(float(dernier))
            except ValueError:
                # Ligne d'en-tete en premiere position : toleree et ignoree.
                if i == 1:
                    if log is not None:
                        log("  Ligne 1 ignoree (en-tete presume) : '{}'".format(ligne.strip()))
                    continue
                raise ErreurTraitement(
                    "[Pluie historique] Ligne {} illisible : '{}'".format(i, ligne))

        if len(valeurs) < 2:
            raise ErreurTraitement(
                "[Pluie historique] {} valeur(s) lue(s) dans le fichier - au moins 2 attendues.".format(
                    len(valeurs)))
        if any(v < 0 for v in valeurs):
            raise ErreurTraitement("[Pluie historique] Le fichier contient des valeurs negatives.")
        cls._valider_nombre_de_pas(len(valeurs), description)

        if log is not None:
            log("  {} valeur(s) lue(s), somme brute = {:.4f} (sera renormalisee a 1.0, "
                "quelle que soit l'unite d'origine - % ou fraction).".format(len(valeurs), sum(valeurs)))

        fractions = cls._normaliser(valeurs, description)
        n = len(fractions)
        temps_min = [int(round(k * pas_min)) for k in range(0, n + 1)]
        cls._verifier_horodatages(temps_min, description)
        return fractions, temps_min[1:]


# ============================================================================
# 2. LOGIQUE SPATIALE / IO RASTER - climat, zero-padding, ecriture
# ============================================================================
# GARANTIE DE GEOREFERENCEMENT :
#   Le CRS et la Transform Affine sont lus UNE SEULE FOIS dans lire_raster()
#   et transmis tels quels (jamais recalcules, jamais recomposes a partir
#   des bounds ou de la resolution) a travers tout le pipeline :
#     lire_raster -> appliquer_zero_padding (geometry_mask utilise LA MEME
#     transform que celle lue) -> ecrire_raster (chaque grille de sortie
#     recoit EXPLICITEMENT ce meme transform/crs, a la fois dans le profil
#     ET via affectation post-ouverture dst.transform/dst.crs, en double
#     securite) -> generer_grilles_temporelles verifie, apres ecriture de
#     la premiere grille, que le fichier reellement ecrit sur disque a bien
#     la transform attendue (reouverture + comparaison) et interrompt le
#     traitement si ce n'est pas le cas.
# ============================================================================

class PreprocesseurRaster:
    """Encapsule les operations spatiales sur le raster : lecture, stress
    climatique, zero-padding, ecriture des grilles temporelles. Ne connait
    rien de tkinter - recoit une fonction `log(message)` en callback, et
    optionnellement une fonction `callback_progression(pourcentage)` pour
    faire remonter une avancee deterministe (0-100) a l'UI."""

    def __init__(self, log, callback_progression=None):
        self.log = log
        self.callback_progression = callback_progression if callback_progression else (lambda pct: None)

    # ------------------------------------------------------------------
    def lire_raster(self, chemin_raster):
        import rasterio

        if not chemin_raster or not Path(chemin_raster).exists():
            raise ErreurTraitement("[Raster brut] Fichier introuvable : {}".format(chemin_raster))
        if Path(chemin_raster).stat().st_size == 0:
            raise ErreurTraitement("[Raster brut] Le fichier existe mais est vide (0 octet).")

        with rasterio.open(chemin_raster) as src:
            profil = src.profile.copy()
            # Transform Affine et CRS : captures ICI, UNE SEULE FOIS, et
            # jamais recalcules ailleurs dans le pipeline.
            transform = src.transform
            crs = src.crs
            nodata = src.nodata
            nb_bandes = src.count
            matrice = src.read(1).astype(np.float32)
            largeur, hauteur = src.width, src.height

        if crs is None:
            raise ErreurTraitement(
                "Le raster n'a pas de systeme de coordonnees defini (CRS manquant). "
                "Corrige la projection dans QGIS avant de relancer le traitement.")

        # Profil de sortie assaini : on impose GTiff/float32/1 bande. Les
        # parametres de tuilage herites d'un raster source tuile peuvent etre
        # incompatibles avec une ecriture non tuilee (GDAL leve alors une
        # erreur peu explicite) : on les retire si le tuilage n'est pas actif.
        profil.update(driver="GTiff", dtype="float32", count=1)
        if not profil.get("tiled", False):
            profil.pop("blockxsize", None)
            profil.pop("blockysize", None)

        self.log("  Raster source    : {}".format(Path(chemin_raster).name))
        self.log("  Dimensions       : {} x {} px ({} bande(s), bande 1 utilisee)".format(
            largeur, hauteur, nb_bandes))
        self.log("  CRS              : {}".format(crs))
        self.log("  Transform Affine : {}".format(transform))
        self.log("  Resolution pixel : {:.4f} x {:.4f} (unites du CRS)".format(
            abs(transform.a), abs(transform.e)))
        self.log("  NoData d'origine : {}".format(nodata))

        return matrice, profil, transform, crs, nodata

    # ------------------------------------------------------------------
    @staticmethod
    def masque_nodata(matrice, nodata):
        """Masque booleen des pixels NoData (valeur sentinelle ET NaN)."""
        masque = np.isnan(matrice)
        if nodata is not None and np.isfinite(nodata):
            masque = masque | np.isclose(matrice, nodata)
        return masque

    # ------------------------------------------------------------------
    def appliquer_stress_climatique(self, matrice, nodata, pourcentage):
        if pourcentage is None or float(pourcentage) == 0.0:
            self.log("Stress climatique : 0 % - raster inchange.")
            self.log("")
            return matrice
        facteur = 1.0 + float(pourcentage) / 100.0
        if facteur < 0:
            raise ErreurTraitement(
                "[Stress climatique] Le facteur multiplicatif est negatif ({:.3f}) avec "
                "stress={} % - verifie la valeur.".format(facteur, pourcentage))

        self.log("=" * 60)
        self.log("STRESS CLIMATIQUE : x {:.4f}  ({:+.1f} %)".format(facteur, pourcentage))
        self.log("=" * 60)

        masque_valide = ~self.masque_nodata(matrice, nodata)
        matrice[masque_valide] *= facteur
        del masque_valide
        self.log("  Facteur applique aux pixels valides uniquement (NoData preserve, in-place).")
        self.log("  Georeferencement inchange (operation purement radiometrique, aucune "
                 "transform/CRS touche a cette etape).")
        self.log("")
        return matrice

    # ------------------------------------------------------------------
    def appliquer_zero_padding(self, matrice, transform, crs, nodata,
                               chemin_shp, marge_m, valeur_hors_bassin=0.0):
        """Force les pixels hors polygone (+ marge) a `valeur_hors_bassin` et
        comble les NoData internes par interpolation spatiale.

        Renvoie (matrice, masque_interieur) : le masque interieur est
        necessaire en aval pour calculer la lame de reference du hyetogramme
        sur le bassin SEUL (sinon les zeros exterieurs, souvent majoritaires,
        ecrasent la moyenne et le hyetogramme affiche des hauteurs en mm sans
        rapport avec la pluie reelle sur le bassin)."""
        from rasterio.features import geometry_mask
        from rasterio.fill import fillnodata
        import geopandas as gpd

        self.log("=" * 60)
        self.log("ZERO-PADDING hors emprise du bassin")
        self.log("=" * 60)

        if not chemin_shp or not Path(chemin_shp).exists():
            raise ErreurTraitement("[Shapefile bassin] Fichier introuvable : {}".format(chemin_shp))

        gdf = gpd.read_file(chemin_shp)
        if gdf.empty:
            raise ErreurTraitement("Le shapefile {} ne contient aucune geometrie.".format(chemin_shp))
        if gdf.crs is None:
            self.log("  ATTENTION : le shapefile n'a AUCUN CRS defini. Ses coordonnees sont "
                     "supposees deja exprimees dans le CRS du raster ({}). Si ce n'est pas le "
                     "cas, le masque sera decale - definis la projection du shapefile dans "
                     "QGIS.".format(crs))
        elif str(gdf.crs) != str(crs):
            self.log("  Reprojection du shapefile ({} -> {})".format(gdf.crs, crs))
            gdf = gdf.to_crs(crs)

        geometrie = gdf.union_all() if hasattr(gdf, "union_all") else gdf.unary_union
        if marge_m and float(marge_m) != 0.0:
            geometrie = geometrie.buffer(float(marge_m))
            self.log("  Marge tampon appliquee : {} m (unites du CRS)".format(marge_m))

        # geometry_mask utilise IMPERATIVEMENT la meme `transform` que celle
        # lue sur le raster source (parametre recu tel quel, jamais recalcule
        # a partir des bounds de la geometrie ou d'une resolution supposee) -
        # c'est ce qui garantit que le masque tombe pixel-pour-pixel au bon
        # endroit et qu'aucun decalage spatial n'est introduit ici.
        masque_ext = geometry_mask(
            geometries=[geometrie], out_shape=matrice.shape, transform=transform, invert=False)
        del geometrie, gdf
        gc.collect()

        masque_int = ~masque_ext
        n_int = int(masque_int.sum())
        pct_int = 100.0 * n_int / masque_int.size
        self.log("  Pixels a l'interieur du polygone : {:.2f} % ({} px)".format(pct_int, n_int))
        if n_int == 0:
            raise ErreurTraitement(
                "[Zero-Padding] Le polygone du bassin ne recouvre AUCUN pixel du raster. "
                "Emprises incompatibles (verifie la projection du shapefile et l'etendue du "
                "raster) - traitement interrompu.")

        masque_nd = self.masque_nodata(matrice, nodata)
        nodata_interne = masque_nd & masque_int
        n_interne = int(nodata_interne.sum())

        if n_interne > 0:
            self.log("  NoData internes au bassin : {} pixel(s) -> comblement par interpolation".format(n_interne))
            # CORRECTION : le masque passe a fillnodata definit les pixels
            # SOURCES (valeur > 0) et les pixels A COMBLER (valeur 0). On
            # exclut donc TOUS les NoData (internes ET externes) des sources.
            # L'ancienne version n'excluait que les NoData internes : les
            # sentinelles exterieures (-9999...) servaient alors de valeurs
            # d'interpolation et contaminaient les trous proches du bord.
            # fillnodata n'a ni ne modifie aucune transform/CRS : dimensions,
            # resolution et origine restent strictement identiques.
            matrice_travail = matrice.copy()
            matrice_travail[masque_nd] = 0.0
            matrice_comblee = fillnodata(
                matrice_travail, mask=(~masque_nd).astype(np.uint8),
                max_search_distance=100, smoothing_iterations=0)
            del matrice, matrice_travail
            matrice = np.asarray(matrice_comblee, dtype=np.float32)
            del matrice_comblee
            gc.collect()
        else:
            self.log("  Aucun NoData interne au bassin.")
        del nodata_interne, masque_nd

        matrice[masque_ext] = valeur_hors_bassin
        residuel = ~np.isfinite(matrice)
        n_residuel = int(residuel.sum())
        if n_residuel:
            self.log("  {} pixel(s) non finis residuels forces a {}.".format(n_residuel, valeur_hors_bassin))
            matrice[residuel] = valeur_hors_bassin
        del residuel

        stats_int = matrice[masque_int]
        self.log("  Pluie moyenne interieure : {:.4f} mm".format(
            float(stats_int.mean()) if stats_int.size else float("nan")))
        self.log("  Pluie min / max interieure : {:.4f} / {:.4f} mm".format(
            float(stats_int.min()) if stats_int.size else float("nan"),
            float(stats_int.max()) if stats_int.size else float("nan")))
        self.log("  Pixels forces a {} mm hors bassin : {}".format(valeur_hors_bassin, int(masque_ext.sum())))
        self.log("  Georeferencement inchange : meme transform/CRS/dimensions qu'en entree "
                 "(aucun reechantillonnage, aucune reprojection a cette etape).")
        self.log("")
        del masque_ext, stats_int
        gc.collect()
        return matrice, masque_int

    # ------------------------------------------------------------------
    def ecrire_raster(self, chemin, matrice, profil, transform, crs, nodata=None):
        """Ecrit un raster GeoTIFF en injectant EXPLICITEMENT transform et
        crs dans le profil (et pas seulement via le profil copie du raster
        source), en plus de l'affectation post-ouverture dst.transform /
        dst.crs - double garantie contre tout decalage spatial. Le NoData
        est egalement force explicitement : si le Zero-Padding a ete
        applique, `nodata` doit etre None (0.0 est une vraie valeur de pluie,
        pas une absence de donnee) ; sinon `nodata` reprend la valeur NoData
        d'origine du raster brut, pour que les pixels manquants restent
        identifies comme tels en sortie."""
        import rasterio
        profil = profil.copy()
        profil.update(driver="GTiff", dtype="float32", count=1,
                      nodata=nodata, transform=transform, crs=crs)
        with rasterio.open(chemin, "w", **profil) as dst:
            dst.crs = crs
            dst.transform = transform
            dst.write(matrice.astype(np.float32), 1)

    # ------------------------------------------------------------------
    def _verifier_georeferencement_fichier(self, chemin, transform_attendu, crs_attendu):
        """Verification de tracabilite : rouvre le fichier tout juste ecrit
        et compare sa transform/CRS effective a celle attendue. Leve une
        erreur explicite (plutot que de laisser un decalage silencieux) si
        un ecart est detecte - appelee une seule fois, sur la premiere
        grille ecrite, pour ne pas alourdir le traitement des suivantes."""
        import rasterio
        with rasterio.open(chemin) as verif:
            transform_lu = verif.transform
            crs_lu = verif.crs
        ecart_transform = max(
            abs(transform_lu.a - transform_attendu.a), abs(transform_lu.b - transform_attendu.b),
            abs(transform_lu.c - transform_attendu.c), abs(transform_lu.d - transform_attendu.d),
            abs(transform_lu.e - transform_attendu.e), abs(transform_lu.f - transform_attendu.f))
        if ecart_transform > 1e-9:
            raise ErreurTraitement(
                "[Georeferencement] Decalage spatial detecte sur {} : transform ecrite {} "
                "!= transform attendue {} (ecart max = {:.3e}). Traitement interrompu avant "
                "d'ecrire d'autres grilles potentiellement decalees.".format(
                    Path(chemin).name, transform_lu, transform_attendu, ecart_transform))
        if str(crs_lu) != str(crs_attendu):
            raise ErreurTraitement(
                "[Georeferencement] CRS incoherent sur {} : ecrit '{}' != attendu '{}'.".format(
                    Path(chemin).name, crs_lu, crs_attendu))
        self.log("  Controle georeferencement (1ere grille) : transform et CRS strictement "
                 "identiques a la source - OK, aucun decalage.")

    # ------------------------------------------------------------------
    def generer_grilles_temporelles(self, matrice_cumul, profil, transform, crs, nodata,
                                    dossier_sortie, fractions, minutes_cumulees, nom_methode,
                                    masque_nodata=None):
        """Ecrit une grille par pas de temps. `masque_nodata` (optionnel) est
        le masque des pixels sans donnee : ces pixels sont REMIS a la valeur
        NoData apres multiplication par la fraction. Sans cela, une sentinelle
        -9999 etait multipliee par la fraction du pas (-9999 x 0.05 = -499.95)
        et n'etait plus reconnue comme NoData ni par HEC-Vortex ni par QGIS."""
        self.log("=" * 60)
        self.log("DISTRIBUTION TEMPORELLE : {}".format(nom_methode))
        self.log("=" * 60)
        self.log("  Horodatage des fichiers (fin de pas) a partir du {:%d/%m/%Y %H:%M} "
                 "(reference conventionnelle pour hyetogramme synthetique, sans lien "
                 "calendaire reel - necessaire pour que HEC-Vortex reconnaisse "
                 "Part D/E). Format : pluie_YYYY-MM-DD_HHMM.tif".format(EPOCH_HYETOGRAMME))
        self.log("")

        dossier_sortie = Path(dossier_sortie)
        dossier_sortie.mkdir(parents=True, exist_ok=True)
        n = len(fractions)
        if minutes_cumulees is None:
            minutes_cumulees = [60 * (i + 1) for i in range(n)]
        if len(minutes_cumulees) != n:
            raise ErreurTraitement(
                "[Interne] {} fractions mais {} horodatages - incoherence.".format(
                    n, len(minutes_cumulees)))

        chemins = []
        somme_verif = np.zeros_like(matrice_cumul)

        self.callback_progression(0.0)
        for i, fraction in enumerate(fractions, start=1):
            matrice_pas = matrice_cumul * fraction
            somme_verif += matrice_pas
            if masque_nodata is not None and nodata is not None:
                matrice_pas[masque_nodata] = nodata

            minutes_ecoulees = minutes_cumulees[i - 1]
            horodatage = EPOCH_HYETOGRAMME + timedelta(minutes=int(minutes_ecoulees))
            nom_fichier = "pluie_{}.tif".format(horodatage.strftime("%Y-%m-%d_%H%M"))
            chemin_fichier = dossier_sortie / nom_fichier
            self.ecrire_raster(chemin_fichier, matrice_pas, profil, transform, crs, nodata)
            if i == 1:
                self._verifier_georeferencement_fichier(chemin_fichier, transform, crs)
            chemins.append(chemin_fichier)
            self.log("  pas {:>3d}/{}  t={:>6d} min  fraction={:7.4f} %  -> {}".format(
                i, n, int(minutes_ecoulees), fraction * 100, nom_fichier))

            del matrice_pas
            if i % 10 == 0:
                gc.collect()
            self.callback_progression((i / n) * 100.0)

        # Conservation de masse : evaluee UNIQUEMENT sur les pixels valides
        # (inclure les sentinelles NoData rendrait le controle absurde).
        if masque_nodata is not None:
            valides = ~masque_nodata
            ecart_max = float(np.abs(somme_verif[valides] - matrice_cumul[valides]).max()) \
                if valides.any() else 0.0
        else:
            ecart_max = float(np.abs(somme_verif - matrice_cumul).max())
        self.log("")
        self.log("  Controle de conservation de masse : ecart max = {:.2e} mm".format(ecart_max))
        if ecart_max > 1e-2:
            self.log("  ATTENTION : ecart superieur a 0.01 mm - verifier la coherence des fractions.")
        else:
            self.log("  OK - conservation de masse verifiee.")
        self.log("  -> {} grille(s) ecrite(s) dans : {}".format(len(chemins), dossier_sortie))
        self.log("")
        del somme_verif
        gc.collect()
        return chemins


