            title=self.T("dlg_hist"),
            filetypes=[("Texte / CSV", "*.txt *.csv"), (self.T("dlg_tous_fichiers"), "*.*")])
        if chemin:
            self.var_e_fichier.set(chemin)

    # ------------------------------------------------------------------
    # La queue transporte trois types de messages, distingues par un tag de
    # type en premiere position du tuple :
    #   ("log", (message, tag_couleur))  -> une ligne de la console
    #   ("progress", pourcentage)        -> mise a jour de la barre determinate
    #   ("hyeto", info)                  -> mise a jour des 2 graphiques + table
    #   ("fin", resultat)                -> fin du traitement : reactivation du
    #                                       bouton + boite de dialogue
    # Le thread d'arriere-plan est seul a ecrire dans la queue ; seul le
    # thread principal (via root.after) la lit et touche les widgets tkinter.
    # ------------------------------------------------------------------
    def _log(self, message, tag=None):
        self.log_queue.put(("log", (message, tag)))

    def _progress(self, pourcentage):
        self.log_queue.put(("progress", pourcentage))

    def _poll_log_queue(self):
        try:
            while True:
                type_message, contenu = self.log_queue.get_nowait()
                if type_message == "log":
                    message, tag = contenu
                    self.zone_log.configure(state="normal")
                    self.zone_log.insert(tk.END, str(message) + "\n", tag if tag else ())
                    self.zone_log.configure(state="disabled")
                    self.zone_log.see(tk.END)
                elif type_message == "progress":
                    pct = max(0.0, min(100.0, float(contenu)))
                    self.barre_progression["value"] = pct
                    self.var_pct_label.set("{:.0f} %".format(pct))
                elif type_message == "hyeto":
                    self._afficher_hyetogramme(contenu)
                elif type_message == "fin":
                    self._traiter_fin_de_traitement(contenu)
        except queue.Empty:
            pass
        self.root.after(100, self._poll_log_queue)

    # ------------------------------------------------------------------
    def _lire_float(self, var, nom_champ, permettre_vide=False):
        texte = var.get().strip().replace(",", ".")
        if texte == "" and permettre_vide:
            return None
        try:
            valeur = float(texte)
        except ValueError:
            raise ErreurTraitement(
                "Le champ '{}' doit etre un nombre valide (recu : '{}').".format(nom_champ, texte))
        if not np.isfinite(valeur):
            raise ErreurTraitement("Le champ '{}' doit etre un nombre fini.".format(nom_champ))
        return valeur

    def _collecter_params_methode(self, methode_id):
        if methode_id in ("I", "IA", "II", "III"):
            return {"pas_min": self._lire_float(self.vars_pas_scs[methode_id], "Pas de temps (min)")}
        if methode_id == "B":
            return {
                "texte_manuel": self.var_b_texte.get(),
                "pas_min": self._lire_float(self.var_b_pas, "Pas de temps (min)"),
            }
        if methode_id == "C":
            return {
                "a": self._lire_float(self.var_c_a, "Parametre a"),
                "b": self._lire_float(self.var_c_b, "Parametre b"),
                "duree_h": self._lire_float(self.var_c_duree, "Duree totale (h)"),
                "pas_min": self._lire_float(self.var_c_pas, "Pas de temps (min)"),
            }
        if methode_id == "D":
            return {
                "duree_h": self._lire_float(self.var_d_duree, "Duree totale (h)"),
                "r": self._lire_float(self.var_d_r, "Coefficient de pointe r"),
                "pas_min": self._lire_float(self.var_d_pas, "Pas de temps (min)"),
            }
        if methode_id == "E":
            chemin = self.var_e_fichier.get().strip()
            if not chemin:
                raise ErreurTraitement("[Pluie historique] Selectionne d'abord un fichier .txt/.csv.")
            return {
                "chemin_fichier": chemin,
                "pas_min": self._lire_float(self.var_e_pas, "Pas de temps (min)"),
            }
        raise ErreurTraitement("Methode inconnue.")

    # ------------------------------------------------------------------
    def _lancer_traitement(self):
        if self.traitement_en_cours:
            messagebox.showinfo(self.T("info_traitement_encours_titre"), self.T("info_traitement_encours"))
            return

        chemin_raster = self.var_raster.get().strip()
        chemin_shp = self.var_shp.get().strip()
        dossier_sortie = self.var_dossier_sortie.get().strip()
        faire_zp = self.var_zero_padding.get()
        methode_id = self._methode_id_courante

        if not chemin_raster:
            messagebox.showerror(self.T("err_fichier_manquant_titre"), self.T("err_raster_manquant"))
            return
        if faire_zp and not chemin_shp:
            messagebox.showerror(self.T("err_fichier_manquant_titre"), self.T("err_shp_manquant"))
            return
        if not dossier_sortie:
            messagebox.showerror(self.T("err_dossier_manquant_titre"), self.T("err_dossier_manquant"))
            return

        try:
            marge_m = self._lire_float(self.var_marge, "Marge Tampon (m)")
            stress_pct = self._lire_float(self.var_stress, "Stress Climatique (%)")
            params_methode = self._collecter_params_methode(methode_id)
        except ErreurTraitement as e:
            messagebox.showerror(self.T("err_param_invalide_titre"), str(e))
            return

        self.zone_log.configure(state="normal")
        self.zone_log.delete("1.0", tk.END)
        self.zone_log.configure(state="disabled")

        self.traitement_en_cours = True
        self.bouton_lancer.configure(state="disabled", text=self.T("bouton_lancer_encours"))
        self.barre_progression["value"] = 0.0
        self.var_pct_label.set("0 %")

        thread = threading.Thread(
            target=self._executer_en_arriere_plan,
            args=(Path(chemin_raster), Path(chemin_shp) if chemin_shp else None, Path(dossier_sortie),
                  marge_m, stress_pct, faire_zp, methode_id, params_methode),
            daemon=True,
        )
        thread.start()

    def _executer_en_arriere_plan(self, chemin_raster, chemin_shp, dossier_sortie,
                                  marge_m, stress_pct, faire_zp, methode_id, params_methode):
        """Corps du thread de traitement. Il n'appelle AUCUNE fonction tkinter
        (ni widget, ni variable Tk, ni root.after) : tout ce qui doit etre
        affiche - lignes de log, progression, hyetogramme, et desormais la
        fin de traitement avec sa boite de dialogue - transite par la queue
        thread-safe et n'est consomme que par le thread principal dans
        _poll_log_queue(). Tkinter n'etant pas thread-safe, un appel direct
        depuis ce thread peut lever "main thread is not in main loop" et
        laisser l'interface bloquee avec le bouton desactive."""
        try:
            executer_traitement(chemin_raster, chemin_shp, dossier_sortie, marge_m, stress_pct,
                                faire_zp, methode_id, params_methode, self._log,
                                callback_progression=self._progress,
                                callback_hyetogramme=self._publier_hyetogramme)
            self._log("")
            self._log(self.T("log_succes"), "succes")
            self.log_queue.put(("fin", {"statut": "succes", "dossier": str(dossier_sortie)}))
        except ErreurTraitement as e:
            message = str(e)
            self._log("")
            self._log("[ERREUR] " + message, "erreur")
            self.log_queue.put(("fin", {"statut": "erreur", "message": message}))
        except Exception as e:
            message = "{} : {}".format(type(e).__name__, e)
            trace = traceback.format_exc()
            self._log("")
            self._log("[ERREUR INATTENDUE] " + message, "erreur")
            self._log(trace, "erreur")
            self.log_queue.put(("fin", {"statut": "erreur_inattendue", "message": message}))

    def _traiter_fin_de_traitement(self, resultat):
        """Execute dans le thread principal uniquement (via _poll_log_queue)."""
        statut = resultat.get("statut")
        self._reinitialiser_apres_traitement()
        if statut == "succes":
            messagebox.showinfo(self.T("succes_titre"),
                                self.T("succes_msg", dossier=resultat.get("dossier", "")))
        elif statut == "erreur":
            messagebox.showerror(self.T("erreur_traitement_titre"), resultat.get("message", ""))
        else:
            messagebox.showerror(self.T("erreur_inattendue_titre"),
                                 self.T("erreur_inattendue_msg", message=resultat.get("message", "")))

    def _reinitialiser_apres_traitement(self):
        self.traitement_en_cours = False
        self.bouton_lancer.configure(state="normal", text=self.T("bouton_lancer"))
        # La barre reste a sa valeur finale (100 % en cas de succes) pour
        # confirmation visuelle ; elle est remise a 0 au prochain lancement.

    def _fermer(self):
        """Fermeture propre : on libere les liaisons globales de la molette et
        la figure matplotlib avant de detruire la fenetre (sinon un thread de
        traitement encore actif peut declencher des callbacks sur des widgets
        deja detruits)."""
        try:
            self._canvas_principal.unbind_all("<MouseWheel>")
            self._canvas_principal.unbind_all("<Button-4>")
            self._canvas_principal.unbind_all("<Button-5>")
        except tk.TclError:
            pass
        try:
            self.figure_hyeto.clear()
        except Exception:
            pass
        self.root.destroy()


